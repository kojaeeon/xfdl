<?xml version="1.0" encoding="utf-8"?>
<FDL version="1.5">
  <Form id="frmCheck" onload="frmCheck_onload">
    <Layouts>
      <Layout>
        <Div id="divSearch">
          <Form>
            <Layouts>
              <Layout>
                <Edit id="edtCustomerNo"/>
                <Button id="btnSearch"
                        onclick="btnSearch_onclick"/>
              </Layout>
            </Layouts>
          </Form>
        </Div>
        <Grid id="grdResult" binddataset="dsResult" oncelldblclick="grdResult_oncelldblclick">
          <Formats>
            <Format id="default">
              <Columns><Column size="140"/><Column size="100"/></Columns>
              <Rows><Row band="head" size="24"/><Row band="head" size="24"/><Row size="24"/></Rows>
              <Band id="head">
                <Cell colspan="2" text="정기점검"/>
                <Cell row="1" text="고객명"/>
                <Cell row="1" col="1" text="점검일자"/>
              </Band>
              <Band id="body">
                <Cell text="bind:customerName"/>
                <Cell col="1" text="bind:checkDate"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="dsSearch">
        <ColumnInfo><Column id="customerNo" type="STRING" size="12"/></ColumnInfo>
      </Dataset>
      <Dataset id="dsResult" onrowposchanged="dsResult_onrowposchanged">
        <ColumnInfo>
          <Column id="customerName" type="STRING" size="100"/>
          <Column id="checkDate" type="STRING" size="8"/>
          <Column id="internalCode" type="STRING" size="10"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="bindCustomerNo" compid="divSearch.form.edtCustomerNo" propid="value" datasetid="dsSearch" columnid="customerNo"/>
    </Bind>
    <Script type="xscript5.0"><![CDATA[
include "lib::common.xjs";

this.frmCheck_onload = function(obj:Form, e:nexacro.LoadEventInfo)
{
    this.fn_init();
    this.divSearch.form.btnSearch.setEventHandlerLookup("onkeydown", "btnSearch_onkeydown", this);
};

this.btnSearch_onclick = function(obj:Button, e:nexacro.ClickEventInfo)
{
    if (this.fn_validate()) {
        this.fn_search();
    }
};

this.btnSearch_onkeydown = function(obj, e)
{
    this.fn_handleKey(e.keycode);
};

this.grdResult_oncelldblclick = function(obj, e)
{
    this.fn_openDetail(e.row);
};

this.dsResult_onrowposchanged = function(obj, e)
{
    this.fn_updateButtons();
};
    ]]></Script>
  </Form>
</FDL>
